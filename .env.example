# ─────────────────────────────────────────────────────────────────────────────
# AutoMind AI — Environment Variables
# Copy to .env and fill in values before running `docker compose up`
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=automind
POSTGRES_PASSWORD=automind
POSTGRES_DB=automind
DATABASE_URL=postgresql+asyncpg://automind:automind@postgres:5432/automind
SYNC_DATABASE_URL=postgresql://automind:automind@postgres:5432/automind

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://automindai.info"]

# ── Ports (override in production) ────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── AWS Bedrock — Primary LLM Provider ───────────────────────────────────────
LLM_PROVIDER=bedrock
# Valid values: bedrock | openai
# bedrock: uses Claude models via AWS Bedrock (requires IAM bedrock:InvokeModel)
# openai:  uses GPT-4o-mini via OpenAI API (requires OPENAI_API_KEY)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── AWS S3 / CloudFront (Asset Storage) ──────────────────────────────────────
AWS_S3_BUCKET=automind-assets-prod
AWS_CLOUDFRONT_DOMAIN=cdn.automindai.info

# ── OpenAI (fallback provider) ───────────────────────────────────────────────
OPENAI_API_KEY=

# ── Video Generation (Kling AI) ──────────────────────────────────────────────
KLING_API_KEY=
KLING_API_BASE=https://api.klingai.com

# ── Video Generation (legacy) ────────────────────────────────────────────────
PEXELS_API_KEY=
REPLICATE_API_TOKEN=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=automind-videos

# ── Billing — Stripe (USD) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Billing — Razorpay (INR) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Social Publishing (Sprint 5) ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
LINKEDIN_CLIENT_ID=
YOUTUBE_API_KEY=

# ── AWS SES — Email (future) ─────────────────────────────────────────────────
SES_FROM_EMAIL=
SES_REGION=us-east-1
